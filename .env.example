# Footy Up platform (registrations, dashboard, Supabase). When set, every form
# on the site goes through the platform and shows up in the admin dashboard.
# Leave empty to use the original checkout code in api/ (rollback).
PLATFORM_API_URL=
# Shared with the platform's SITE_API_KEY so it can rate-limit per family.
SITE_API_KEY=

# Stripe (required for camp registration & private training checkout)
STRIPE_SECRET_KEY=sk_test_...

# Telegram (required for training inquiry form notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
