# Copy to .env for local development. Never commit real values.

# Postgres. Locally: any Postgres 15+. On Vercel: the Supabase *transaction pooler* URL (port 6543).
DATABASE_URL=postgres://footy:footy@localhost:5432/footyup_dev
# Optional: direct (non-pooled) Supabase URL, used by the migration and admin scripts.
DIRECT_DATABASE_URL=

# Public site origin, used for Stripe success/cancel redirects.
PUBLIC_SITE_URL=http://localhost:4319

# "mock" runs a fake Stripe Checkout locally. Leave unset with STRIPE_SECRET_KEY set to use Stripe test mode.
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. Without BREVO_API_KEY, emails are logged (subject only) instead of sent.
BREVO_API_KEY=
EMAIL_FROM=no-reply@footyup.net
EMAIL_FROM_NAME=Footy Up

# Optional Cloudflare Turnstile for the private training form.
TURNSTILE_SECRET_KEY=

# Vercel sends this as a Bearer token to cron routes. Required in production.
CRON_SECRET=

# Salt for hashing client IPs in rate-limit keys. Required in production.
RATE_LIMIT_SALT=

# Admin dashboard login (Supabase Auth). Leave empty locally to use the dev login.
SUPABASE_URL=
# Publishable/anon key: safe in the browser, sent to the dashboard.
SUPABASE_ANON_KEY=
# Service role/secret key: server-only. Sends admin invites from Settings → Admins
# and `pnpm admins add`. Set it on Vercel as a normal (server) variable; never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Where admin invite and password-reset links land, e.g. https://<deployment>/admin/
PUBLIC_ADMIN_URL=

# Other domains whose pages may call the API from the browser, comma-separated.
CORS_ALLOWED_ORIGINS=

# Brevo webhook secret (unsubscribe/bounce sync). Any long random string.
BREVO_WEBHOOK_SECRET=
# Optional overrides
PUBLIC_API_URL=
EMAIL_DOMAIN=


# With a real BREVO_API_KEY outside production, real email only goes to these
# addresses (comma-separated; @yourdomain.com allows a whole domain).
EMAIL_TEST_RECIPIENTS=
