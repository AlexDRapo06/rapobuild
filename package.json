{
  "name": "footy-up",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "cd platform && tsx --env-file-if-exists=.env scripts/dev-server.ts",
    "build": "cd platform && ADMIN_OUT_DIR=../dist/admin tsx scripts/build-admin.ts && tsx scripts/build-site.ts && tsx scripts/load-season-data.ts",
    "admin:build": "cd platform && tsx scripts/build-admin.ts",
    "admin:watch": "cd platform && tsx scripts/build-admin.ts --watch",
    "db:migrate": "cd platform && tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "cd platform && tsx --env-file-if-exists=.env scripts/migrate.ts --reset",
    "camps:upsert": "cd platform && tsx --env-file-if-exists=.env scripts/camps.ts",
    "miami": "cd platform && tsx --env-file-if-exists=.env scripts/miami.ts",
    "settings": "cd platform && tsx --env-file-if-exists=.env scripts/settings.ts",
    "waiver": "cd platform && tsx --env-file-if-exists=.env scripts/waiver.ts",
    "admins": "cd platform && tsx --env-file-if-exists=.env scripts/admins.ts",
    "stripe:backfill": "cd platform && tsx --env-file-if-exists=.env scripts/stripe-backfill.ts",
    "typecheck": "cd platform && tsc --noEmit && tsc --noEmit -p admin",
    "licenses:check": "cd platform && tsx scripts/check-licenses.ts",
    "test": "cd platform && tsx tests/setup-db.ts && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "demo:data": "cd platform && tsx scripts/demo-data.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
